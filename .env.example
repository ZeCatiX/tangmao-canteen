# 唐猫庭院 - 环境配置示例
# 复制此文件为 .env 并修改配置

# 服务器端口
PORT=3000

# PostgreSQL 数据库配置
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=tangmao
PG_USER=postgres
PG_PASSWORD=请修改为你的数据库密码

# JWT 密钥（用于用户登录验证）
# 生产环境请使用强随机字符串
LOGIN_RATE_LIMIT_MAX=5
JWT_SECRET=请修改为随机字符串
JWT_EXPIRES_IN=7d

# 日志级别: error / warn / info / debug
LOG_LEVEL=info

# 数据库备份目录
BACKUP_DIR=./backups

# 请求限流（可选）
RATE_LIMIT_WINDOW_MS=900000   # 15 分钟
RATE_LIMIT_MAX=1000            # 最大请求次数（测试环境放宽，生产建议100）

# 数据库编码设置（可选，Windows 环境可能需要）
PGOPTIONS=-c client_encoding=UTF8

# CORS 允许的来源（可选，默认仅允许 http://localhost:3000）
# CORS_ORIGIN=https://your-domain.com

# 管理后台账号（可选，默认 admin / 请修改为管理后台密码）
ADMIN_USER=admin
ADMIN_PASS=请修改为管理后台密码（至少8位）

# HTTPS 配置（可选，留空则不启用）
# SSL_KEY=./ssl/key.pem
# SSL_CERT=./ssl/cert.pem
# SSL_PORT=3443
ADMIN_LOGIN_RATE_LIMIT_MAX=5

# 每桌60秒窗口最多下单数(防刷单;测试环境可放宽)
ORDER_FREQ_LIMIT=5
