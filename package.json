{
  "name": "campus-canteen-recommendation-system",
  "version": "1.0.0",
  "description": "校园食堂菜品推荐系统网页版",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node build.js",
    "test": "node --test tests/api.test.js",
    "posttest": "node scripts/cleanup_test_orders.js && node scripts/cleanup_test_dishes.js",
    "test:all": "node --test --test-concurrency=2 tests/api.test.js tests/e2e.test.js tests/comprehensive_e2e.test.js tests/enhanced_e2e.test.js tests/admin_auth_test.js tests/gift_append.test.js tests/trust_proxy_e2e.test.js",
    "posttest:all": "node scripts/cleanup_test_orders.js && node scripts/cleanup_test_dishes.js",
    "test:watch": "node --test --watch tests/api.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:comprehensive": "node --test tests/comprehensive_e2e.test.js",
    "lint": "eslint server.js server/ scripts/ js/ tests/ build.js auth.js db.js",
    "format": "prettier --write server.js server/**/*.js scripts/**/*.js js/*.js tests/*.test.js build.js auth.js db.js",
    "format:check": "prettier --check server.js server/**/*.js scripts/**/*.js js/*.js tests/*.test.js build.js auth.js db.js",
    "docs": "jsdoc server.js js/ -d docs -R README.md",
    "security": "npm audit",
    "mdlint": "markdownlint \"*.md\"",
    "coverage": "c8 node --test tests/api.test.js",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "vision:info": "node -e \"const fs=require('fs');const path=require('path');const sharp=require('sharp');(async()=>{const dir='uploads';const files=fs.readdirSync(dir);for(const f of files){try{const m=await sharp(path.join(dir,f)).metadata();console.log(f+': '+m.width+'x'+m.height+' '+m.format+' | '+(m.size/1024).toFixed(1)+'KB')}catch(e){console.log(f+': error')}}})()\"",
    "vision:ocr": "node -e \"const T=require('tesseract.js');const img=process.argv[2]&&!process.argv[2].startsWith('-')?process.argv[2]:'uploads/tangmao_锅子鱼.jpg';(async()=>{const{data}=await T.recognize(img,'chi_sim');console.log(data.text)})()\"",
    "pretest": "node build.js",
    "vision:pipeline": "node vision_pipeline.js",
    "test:full": "node --test --test-concurrency=1 tests/*.test.js",
    "posttest:full": "node scripts/cleanup_test_orders.js && node scripts/cleanup_test_dishes.js"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@modelcontextprotocol/server-memory": "^2026.7.4",
    "@modelcontextprotocol/server-sequential-thinking": "^2026.7.4",
    "@playwright/mcp": "^0.0.78",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.5.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "globals": "^17.13.0",
    "jsdoc": "^4.0.5",
    "markdownlint-cli": "^0.49.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.9.6",
    "probe-image-size": "^7.3.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "keywords": [
    "recommendation",
    "canteen",
    "machine-learning"
  ],
  "author": "AI Assistant",
  "license": "MIT"
}
