# ═══════════════════════════════════════════════════════════════
# 唐猫庭院 · 生产环境配置模板
#
# 用法：
#   cp .env.production.example .env      然后逐项替换成真实值
#
# 注意：以 NODE_ENV=production 启动时 server.js 会校验本文件里带 ★ 的项 ——
#       密钥弱 / 限流过宽会【直接拒绝启动】，CORS 和 HTTPS 会告警。
#       这么做是防止把开发用的宽松配置整份带到线上。
#
# 生成强随机密钥：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production

# ─── ★ 密钥（必须替换，否则拒绝启动）───────────────────────────
JWT_SECRET=在这里填入64位十六进制随机串
JWT_EXPIRES_IN=7d
TABLE_SECRET=在这里填入32位以上十六进制随机串
ADMIN_USER=admin
ADMIN_PASS=在这里填入12位以上强密码

# ─── ★ 限流（生产值；开发环境那套 2000/100000 是给并发测试用的，别带上来）───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000             # 全站 /api/ ：15 分钟 1000 次
LOGIN_RATE_LIMIT_MAX=10         # 用户登录：每分钟 10 次
REGISTER_RATE_LIMIT_MAX=5       # 用户注册：每小时 5 次
ADMIN_LOGIN_RATE_LIMIT_MAX=10   # 管理员登录：每分钟 10 次
HEALTH_RATE_LIMIT_MAX=60        # 健康检查：每分钟 60 次

# ─── 跨域（前端与后端同源部署可留空；跨域部署必须填真实域名）───
CORS_ORIGIN=https://你的域名.com

# ─── 数据库 ────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=tangmao
PG_USER=postgres
PG_PASSWORD=在这里填入数据库密码
PGOPTIONS=-c client_encoding=UTF8

# ─── HTTPS 证书 ────────────────────────────────────────────────
# 方案 A：本服务直接终止 TLS —— 填正式证书（Let's Encrypt 等），不要自签名
# 方案 B：前面挂 Nginx/CDN 终止 TLS —— 这两项留空，让反向代理转发到 3000 端口
SSL_KEY=
SSL_CERT=
SSL_PORT=3443

# ─── 其他 ──────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
BACKUP_DIR=./backups

# ═══════════════════════════════════════════════════════════════
# 上线检查清单（配置之外）
#   [ ] 数据库定时备份：把 backup_db.js 挂进 crontab / 计划任务
#   [ ] 防火墙只放行 80/443，3000 与 5432 不要暴露到公网
#   [ ] 确认 .env 不会被打包进镜像或提交到 git（已在 .gitignore）
#   [ ] 首启后到后台「模型管理」确认「启用用户反馈重训」处于关闭状态
#       （未上线时反馈都是测试数据，攒够真实反馈再打开）
# ═══════════════════════════════════════════════════════════════
